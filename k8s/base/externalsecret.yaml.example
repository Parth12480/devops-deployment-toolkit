# TEMPLATE ONLY: install External Secrets Operator and configure a SecretStore first.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: app-config
  namespace: devops-demo
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: cloud-secret-store
    kind: ClusterSecretStore
  target:
    name: app-config
    creationPolicy: Owner
  data:
    - secretKey: EXAMPLE_TOKEN
      remoteRef:
        key: devops-demo/staging
        property: exampleToken
